extends ../layout

block contenido
  div(class='relative flex min-h-screen w-full flex-col overflow-x-hidden')

    //- Navbar
	
    header(class='flex items-center justify-between whitespace-nowrap border-b border-outline-variant px-6 lg:px-10 py-3 sticky top-0 z-50 bg-background/90 backdrop-blur-md')
      div(class='flex items-center gap-4')
        a(href='/publicaciones/' + publicacion.id class='flex items-center justify-center w-10 h-10 rounded-lg bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
          span(class='material-symbols-outlined text-xl') arrow_back
        a(href='/' class='text-primary font-bold text-lg tracking-[-0.015em]') Fotaza 2
      div(class='flex items-center gap-2')
        if usuario
          span(class='text-on-surface-variant text-sm hidden md:block')= usuario.username
          form(action='/logout' method='POST' class='flex items-center')
            button(type='submit' class='flex items-center justify-center rounded-lg h-10 w-10 bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
              span(class='material-symbols-outlined text-xl') logout

    main(class='flex-1 max-w-3xl mx-auto w-full p-6 lg:p-8')

      div(class='mb-8')
        h1(class='text-on-surface text-2xl font-bold tracking-tight mb-1') Denuncias de comentarios
        p(class='text-on-surface-variant text-sm')= 'Publicación: ' + publicacion.titulo

      //- Flash messages
      if error && error.length
        div(class='mb-6 bg-error-container text-on-error-container text-sm px-4 py-3 rounded-xl')
          each msg in error
            p= msg
      if success && success.length
        div(class='mb-6 bg-teal-900 text-teal-100 text-sm px-4 py-3 rounded-xl')
          each msg in success
            p= msg

      if comentarios && comentarios.length
        div(class='flex flex-col gap-6')
          each comentario in comentarios
            div(class='bg-surface rounded-xl border border-outline-variant overflow-hidden mb-6')
              div(class='p-4 border-b border-outline-variant')
                div(class='flex items-center justify-between mb-2')
                  div(class='flex items-center gap-2')
                    span(class='material-symbols-outlined text-on-surface-variant text-base') person
                    a(href='/usuarios/' + comentario.autor_id class='text-on-surface text-sm font-medium hover:text-primary transition-colors')= '@' + comentario.autor_comentario
                    span(class='text-on-surface-variant text-xs')= new Date(comentario.comentario_fecha).toLocaleDateString('es-AR')
                  div(class='flex items-center gap-3')
                    span(class='flex items-center gap-1 text-error text-xs')
                      span(class='material-symbols-outlined text-sm') flag
                      | #{comentario.total_denuncias} denuncia#{comentario.total_denuncias !== 1 ? 's' : ''}
                    form(action='/publicaciones/' + publicacion.id + '/comentarios/' + comentario.comentario_id + '/eliminar' method='POST')
                      button(type='submit' class='flex items-center gap-1 bg-error text-white text-xs px-3 py-1.5 rounded-lg hover:opacity-90 transition-colors font-medium')
                        span(class='material-symbols-outlined text-sm') delete
                        | Eliminar
                p(class='text-on-surface text-sm leading-relaxed mt-2')= comentario.contenido
              div(class='p-4')
                p(class='text-on-surface-variant text-xs font-medium uppercase tracking-wider mb-3') Denuncias recibidas
                div(class='flex flex-col gap-3')
                  each denuncia in comentario.denuncias
                    div(class='bg-surface-container rounded-lg p-3 border border-outline-variant')
                      div(class='flex items-center justify-between mb-1')
                        span(class='text-xs bg-error/10 text-error px-2 py-0.5 rounded-full')= denuncia.motivo
                        span(class='text-on-surface-variant text-xs')= '@' + denuncia.usuario
                      p(class='text-on-surface-variant text-xs')= denuncia.descripcion