extends ../layout

block contenido
  div(class='relative flex min-h-screen w-full flex-col overflow-x-hidden')

    //- Navbar
    header(class='flex items-center justify-between whitespace-nowrap border-b border-outline-variant px-6 lg:px-10 py-3 sticky top-0 z-50 bg-background/90 backdrop-blur-md')
      div(class='flex items-center gap-4')
        a(href='/publicaciones/' + publicacion_id class='flex items-center justify-center w-10 h-10 rounded-lg bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
          span(class='material-symbols-outlined text-xl') arrow_back
        a(href='/' class='text-primary font-bold text-lg tracking-[-0.015em]') Fotaza 2
      div(class='flex items-center gap-2')
        if usuario
          span(class='text-on-surface-variant text-sm hidden md:block')= usuario.username

    main(class='flex-1 max-w-lg mx-auto w-full p-6 lg:p-8')

      div(class='mb-8')
        h1(class='text-on-surface text-2xl font-bold tracking-tight mb-1') Denunciar comentario
        p(class='text-on-surface-variant text-sm') Contanos por qué querés denunciar este comentario.

      //- Flash messages
      if error && error.length
        div(class='mb-6 bg-error-container text-on-error-container text-sm px-4 py-3 rounded-xl')
          each msg in error
            p= msg

      //- Info comentario
      div(class='bg-surface-container rounded-xl p-4 border border-outline-variant mb-6')
        p(class='text-on-surface text-sm')= comentario.contenido
        p(class='text-on-surface-variant text-xs mt-1')= '@' + comentario.username

      form(action='/publicaciones/' + publicacion_id + '/comentarios/' + comentario.id + '/denunciar' method='POST' class='flex flex-col gap-5')

        //- Motivo
        div(class='flex flex-col gap-2')
          label(class='text-sm font-medium text-on-surface') Motivo *
          select(
            class='w-full bg-surface-container border-none focus:ring-2 focus:ring-primary rounded-xl px-4 py-3.5 text-on-surface transition-all text-sm'
            name='motivo_id' required
          )
            option(value='') Seleccioná un motivo
            each motivo in motivos
              option(value=motivo.id)= motivo.descripcion

        //- Descripción
        div(class='flex flex-col gap-2')
          label(class='text-sm font-medium text-on-surface') Descripción *
          textarea(
            class='w-full bg-surface-container border-none focus:ring-2 focus:ring-primary rounded-xl p-4 text-on-surface placeholder:text-on-surface-variant/50 transition-all resize-none text-sm'
            name='descripcion' rows='4' placeholder='Describí detalladamente el motivo de tu denuncia...' required
          )

        div(class='flex gap-4 pt-2')
          a(href='/publicaciones/' + publicacion_id class='flex-1 flex items-center justify-center py-3 rounded-xl border border-outline text-on-surface-variant text-sm font-medium hover:bg-surface-container transition-colors') Cancelar
          button(
            type='submit'
            class='flex-1 bg-error text-white font-headline font-bold py-3 rounded-xl hover:opacity-90 active:scale-[0.98] transition-all text-sm'
          ) Enviar denuncia