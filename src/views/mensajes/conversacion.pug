extends ../layout

block contenido
  div(class='relative flex min-h-screen w-full flex-col overflow-x-hidden')

    //- Navbar
    header(class='flex items-center justify-between whitespace-nowrap border-b border-outline-variant px-6 lg:px-10 py-3 sticky top-0 z-50 bg-background/90 backdrop-blur-md')
      div(class='flex items-center gap-4')
        a(href='/mensajes' class='flex items-center justify-center w-10 h-10 rounded-lg bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
          span(class='material-symbols-outlined text-xl') arrow_back
        a(href='/' class='text-primary font-bold text-lg tracking-[-0.015em]') Fotaza 2
      div(class='flex items-center gap-2')
        if usuario
          span(class='text-on-surface-variant text-sm hidden md:block')= usuario.username
          form(action='/logout' method='POST' class='flex items-center')
            button(type='submit' class='flex items-center justify-center rounded-lg h-10 w-10 bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
              span(class='material-symbols-outlined text-xl') logout

    main(class='flex-1 max-w-2xl mx-auto w-full flex flex-col p-6 lg:p-8')

      //- Cabecera conversación
      div(class='flex items-center gap-3 mb-6 pb-6 border-b border-outline-variant')
        div(class='w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center')
          span(class='material-symbols-outlined text-primary') person
        div
          p(class='text-on-surface font-medium')= '@' + otro_usuario.username
          p(class='text-on-surface-variant text-xs')= otro_usuario.nombre + ' ' + otro_usuario.apellido

      //- Flash messages
      if error && error.length
        div(class='mb-4 bg-error-container text-on-error-container text-sm px-4 py-3 rounded-xl')
          each msg in error
            p= msg

      //- Mensajes
      div#mensajes-container(class='flex flex-col gap-3 mb-6 h-[400px] overflow-y-auto pr-2')
        if mensajes && mensajes.length
          each msg in mensajes
            div(
              class='flex ' + (msg.remitente_id === usuario.id ? 'justify-end' : 'justify-start')
              data-mensaje-id=msg.id
            )
              div(class='max-w-xs lg:max-w-md px-4 py-3 rounded-xl ' + (msg.remitente_id === usuario.id ? 'bg-primary text-on-primary' : 'bg-surface-container text-on-surface'))
                p(class='text-sm')= msg.contenido
                p(class='text-xs mt-1 ' + (msg.remitente_id === usuario.id ? 'text-on-primary/70' : 'text-on-surface-variant'))= new Date(msg.created_at).toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' })
        else
          div(class='flex-1 flex items-center justify-center')
            p#sin-mensajes(class='text-on-surface-variant text-sm') Iniciá la conversación

      //- Formulario enviar mensaje
      form#form-mensaje(action='/mensajes/' + otro_usuario.id method='POST' class='flex gap-3')
        div(class='relative group flex-1')
          input#input-mensaje(
            class='w-full bg-surface-container border-none focus:ring-2 focus:ring-primary rounded-xl px-4 py-3 text-on-surface placeholder:text-on-surface-variant/50 transition-all text-sm'
            name='contenido' type='text' placeholder='Escribí un mensaje...' required
          )
        button(
          type='submit'
          class='flex items-center justify-center bg-primary text-on-primary w-12 h-12 rounded-xl hover:bg-primary-container transition-colors flex-shrink-0'
        )
          span(class='material-symbols-outlined') send

  //- Datos para Socket.io
  script.
    const USUARIO_ID      = #{usuario.id}
    const OTRO_USUARIO_ID = #{otro_usuario.id}
    const USERNAME        = "#{usuario.username}"

  script(src='/socket.io/socket.io.js')
  script(src='/js/chat.js')