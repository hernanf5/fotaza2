extends ../layout

block contenido
  div(class='relative flex min-h-screen w-full flex-col overflow-x-hidden')

    //- Navbar
    header(class='flex items-center justify-between whitespace-nowrap border-b border-outline-variant px-6 lg:px-10 py-3 sticky top-0 z-50 bg-background/90 backdrop-blur-md')
      div(class='flex items-center gap-4')
        h2(class='text-primary font-bold text-lg tracking-[-0.015em]') Fotaza 2
        span(class='text-on-surface-variant text-sm') Panel de Validador
      div(class='flex items-center gap-2')
        span(class='text-on-surface-variant text-sm hidden md:block')= usuario.nombre + ' ' + usuario.apellido
        form(action='/logout' method='POST' class='flex items-center')
          button(type='submit' class='flex items-center justify-center rounded-lg h-10 w-10 bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
            span(class='material-symbols-outlined text-xl') logout

    main(class='flex-1 max-w-4xl mx-auto w-full p-6 lg:p-8')

      //- Flash messages
      if error && error.length
        div(class='mb-6 bg-error-container text-on-error-container text-sm px-4 py-3 rounded-xl')
          each msg in error
            p= msg
      if success && success.length
        div(class='mb-6 bg-teal-900 text-teal-100 text-sm px-4 py-3 rounded-xl')
          each msg in success
            p= msg

      //- Cabecera
      div(class='mb-8')
        h1(class='text-on-surface text-2xl font-bold tracking-tight mb-1') Publicaciones en revisión
        p(class='text-on-surface-variant text-sm') Publicaciones con más de 3 denuncias que requieren tu atención.

      //- Lista de publicaciones
      if publicaciones && publicaciones.length
        div(class='flex flex-col gap-4')
          each pub in publicaciones
            div(class='bg-surface rounded-xl border border-outline-variant overflow-hidden')
              div(class='flex gap-4 p-4')
                if pub.imagen_portada
                  img(src=pub.imagen_portada alt=pub.titulo class='w-24 h-24 object-cover rounded-lg flex-shrink-0')
                else
                  div(class='w-24 h-24 bg-surface-container rounded-lg flex items-center justify-center flex-shrink-0')
                    span(class='material-symbols-outlined text-3xl text-on-surface-variant') image
                div(class='flex-1 min-w-0')
                  h3(class='text-on-surface font-medium text-base mb-1 truncate')= pub.titulo
                  p(class='text-on-surface-variant text-sm mb-1')= '@' + pub.username
                  div(class='flex items-center gap-1 text-error text-sm')
                    span(class='material-symbols-outlined text-base') flag
                    span= pub.total_denuncias + ' denuncias'
              div(class='flex gap-3 px-4 pb-4')
                a(
                  href='/validador/publicaciones/' + pub.id
                  class='flex-1 flex items-center justify-center gap-2 py-2 rounded-lg border border-outline-variant text-on-surface-variant text-sm hover:bg-surface-container transition-colors'
                )
                  span(class='material-symbols-outlined text-base') visibility
                  | Ver denuncias
                form(action='/validador/publicaciones/' + pub.id + '/desestimar' method='POST' class='flex-1')
                  button(
                    type='submit'
                    class='w-full flex items-center justify-center gap-2 py-2 rounded-lg border border-outline-variant text-on-surface-variant text-sm hover:bg-surface-container transition-colors'
                  )
                    span(class='material-symbols-outlined text-base') thumb_up
                    | Desestimar
                form(action='/validador/publicaciones/' + pub.id + '/dar-de-baja' method='POST' class='flex-1')
                  button(
                    type='submit'
                    class='w-full flex items-center justify-center gap-2 py-2 rounded-lg bg-error text-white text-sm hover:opacity-90 transition-colors'
                  )
                    span(class='material-symbols-outlined text-base') delete_forever
                    | Dar de baja
      else
        div(class='bg-surface-container rounded-xl p-12 text-center border border-outline-variant')
          span(class='material-symbols-outlined text-4xl text-on-surface-variant') check_circle
          p(class='text-on-surface-variant text-sm mt-2') No hay publicaciones en revisión.