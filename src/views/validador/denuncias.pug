extends ../layout

block contenido
  div(class='relative flex min-h-screen w-full flex-col overflow-x-hidden')

    //- Navbar
    header(class='flex items-center justify-between whitespace-nowrap border-b border-outline-variant px-6 lg:px-10 py-3 sticky top-0 z-50 bg-background/90 backdrop-blur-md')
      div(class='flex items-center gap-4')
        a(href='/validador' class='flex items-center justify-center w-10 h-10 rounded-lg bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
          span(class='material-symbols-outlined text-xl') arrow_back
        h2(class='text-primary font-bold text-lg tracking-[-0.015em]') Fotaza 2
      div(class='flex items-center gap-2')
        span(class='text-on-surface-variant text-sm hidden md:block')= usuario.nombre + ' ' + usuario.apellido
        form(action='/logout' method='POST' class='flex items-center')
          button(type='submit' class='flex items-center justify-center rounded-lg h-10 w-10 bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
            span(class='material-symbols-outlined text-xl') logout

    main(class='flex-1 max-w-4xl mx-auto w-full p-6 lg:p-8')

      //- Flash messages
      if error && error.length
        div(class='mb-6 bg-error-container text-on-error-container text-sm px-4 py-3 rounded-xl')
          each msg in error
            p= msg

      //- Cabecera
      div(class='mb-6')
        h1(class='text-on-surface text-2xl font-bold tracking-tight mb-1')= publicacion.titulo
        p(class='text-on-surface-variant text-sm')= '@' + publicacion.username

      //- Imágenes
      if imagenes && imagenes.length
        div(class='flex gap-3 mb-8 overflow-x-auto')
          each imagen in imagenes
            img(src=imagen.url alt=publicacion.titulo class='h-40 object-cover rounded-xl flex-shrink-0')

      //- Denuncias
      div(class='mb-8')
        h2(class='text-on-surface text-lg font-bold mb-4')= denuncias.length + ' denuncias recibidas'
        div(class='flex flex-col gap-3')
          each denuncia in denuncias
            div(class='bg-surface-container rounded-xl p-4 border border-outline-variant')
              div(class='flex items-center justify-between mb-2')
                span(class='text-on-surface text-sm font-medium')= '@' + denuncia.username
                span(class='text-on-surface-variant text-xs')= new Date(denuncia.created_at).toLocaleDateString('es-AR')
              span(class='inline-block text-xs bg-error/10 text-error px-3 py-1 rounded-full mb-2')= denuncia.motivo
              p(class='text-on-surface-variant text-sm')= denuncia.descripcion

      //- Acciones
      div(class='flex gap-4')
        form(action='/validador/publicaciones/' + publicacion.id + '/desestimar' method='POST' class='flex-1')
          button(
            type='submit'
            class='w-full flex items-center justify-center gap-2 py-3 rounded-xl border border-outline-variant text-on-surface-variant text-sm font-medium hover:bg-surface-container transition-colors'
          )
            span(class='material-symbols-outlined text-base') thumb_up
            | Desestimar denuncias
        form(action='/validador/publicaciones/' + publicacion.id + '/dar-de-baja' method='POST' class='flex-1')
          button(
            type='submit'
            class='w-full flex items-center justify-center gap-2 py-3 rounded-xl bg-error text-white text-sm font-medium hover:opacity-90 transition-colors'
          )
            span(class='material-symbols-outlined text-base') delete_forever
            | Dar de baja publicación