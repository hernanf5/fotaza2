extends ../layout

block contenido
  div(class='relative flex min-h-screen w-full flex-col overflow-x-hidden')

    //- Navbar
    header(class='flex items-center justify-between whitespace-nowrap border-b border-outline-variant px-6 lg:px-10 py-3 sticky top-0 z-50 bg-background/90 backdrop-blur-md')
      div(class='flex items-center gap-4')
        a(href='/publicaciones/' + publicacion.id class='flex items-center justify-center w-10 h-10 rounded-lg bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
          span(class='material-symbols-outlined text-xl') arrow_back
        a(href='/' class='text-primary font-bold text-lg tracking-[-0.015em]') Fotaza 2
      div(class='flex items-center gap-2')
        if usuario
          span(class='text-on-surface-variant text-sm hidden md:block')= usuario.username
          form(action='/logout' method='POST' class='flex items-center')
            button(type='submit' class='flex items-center justify-center rounded-lg h-10 w-10 bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
              span(class='material-symbols-outlined text-xl') logout

    main(class='flex-1 max-w-2xl mx-auto w-full p-6 lg:p-8')

      div(class='mb-8')
        h1(class='text-on-surface text-2xl font-bold tracking-tight mb-1') Editar publicación
        p(class='text-on-surface-variant text-sm') Modificá el título, descripción o etiquetas.

      //- Flash messages
      if error && error.length
        div(class='mb-6 bg-error-container text-on-error-container text-sm px-4 py-3 rounded-xl')
          each msg in error
            p= msg

      form(action='/publicaciones/' + publicacion.id + '/editar' method='POST' class='flex flex-col gap-6')

        //- Título
        div(class='flex flex-col gap-2')
          label(class='text-sm font-medium text-on-surface' for='titulo') Título *
          div(class='relative group')
            span(class='material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant group-focus-within:text-primary transition-colors') title
            input(
              class='w-full bg-surface-container border-none focus:ring-2 focus:ring-primary rounded-xl pl-12 py-3.5 text-on-surface placeholder:text-on-surface-variant/50 transition-all'
              id='titulo' name='titulo' type='text' value=publicacion.titulo required
            )

        //- Descripción
        div(class='flex flex-col gap-2')
          label(class='text-sm font-medium text-on-surface' for='descripcion') Descripción
          textarea(
            class='w-full bg-surface-container border-none focus:ring-2 focus:ring-primary rounded-xl p-4 text-on-surface placeholder:text-on-surface-variant/50 transition-all resize-none'
            id='descripcion' name='descripcion' rows='3'
          )= publicacion.descripcion || ''

        //- Etiquetas
        div(class='flex flex-col gap-2')
          label(class='text-sm font-medium text-on-surface' for='etiquetas') Etiquetas
          div(class='relative group')
            span(class='material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant group-focus-within:text-primary transition-colors') tag
            input(
              class='w-full bg-surface-container border-none focus:ring-2 focus:ring-primary rounded-xl pl-12 py-3.5 text-on-surface placeholder:text-on-surface-variant/50 transition-all'
              id='etiquetas' name='etiquetas' type='text'
              value=etiquetas.map(e => e.nombre).join(', ')
              placeholder='naturaleza, viajes, fotografía (separadas por coma)'
            )

        //- Botones
        div(class='flex gap-4 pt-2')
          a(href='/publicaciones/' + publicacion.id class='flex-1 flex items-center justify-center py-3 rounded-xl border border-outline text-on-surface-variant text-sm font-medium hover:bg-surface-container transition-colors') Cancelar
          button(
            type='submit'
            class='flex-1 bg-primary text-on-primary font-headline font-bold py-3 rounded-xl hover:bg-primary-container active:scale-[0.98] transition-all text-sm'
          ) Guardar cambios

      //- Eliminar publicación
      div(class='mt-10 pt-6 border-t border-outline-variant')
        h2(class='text-on-surface text-base font-medium mb-2') Zona de peligro
        p(class='text-on-surface-variant text-sm mb-4') Esta acción es irreversible. Se eliminarán la publicación y todas sus imágenes.
        form(action='/publicaciones/' + publicacion.id + '/eliminar' method='POST')
          button(
            type='submit'
            class='flex items-center gap-2 bg-error text-white text-sm font-medium px-4 py-3 rounded-xl hover:opacity-90 transition-colors'
            onclick='return confirm("¿Estás seguro que querés eliminar esta publicación?")'
          )
            span(class='material-symbols-outlined text-base') delete_forever
            | Eliminar publicación