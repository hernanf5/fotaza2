extends ../layout

block contenido
  div(class='relative flex min-h-screen w-full flex-col overflow-x-hidden')

    //- Navbar
    header(class='flex items-center justify-between whitespace-nowrap border-b border-outline-variant px-6 lg:px-10 py-3 sticky top-0 z-50 bg-background/90 backdrop-blur-md')
      div(class='flex items-center gap-4')
        a(href='/' class='text-primary font-bold text-lg tracking-[-0.015em]') Fotaza 2
      div(class='flex items-center gap-2')
        if usuario
          span(class='text-on-surface-variant text-sm hidden md:block')= usuario.username
          form(action='/logout' method='POST' class='flex items-center')
            button(type='submit' class='flex items-center justify-center rounded-lg h-10 w-10 bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
              span(class='material-symbols-outlined text-xl') logout

    //- Contenido
    main(class='flex-1 max-w-2xl mx-auto w-full p-6 lg:p-8')

      div(class='mb-8')
        h1(class='text-on-surface text-2xl font-bold tracking-tight mb-1') Nueva publicación
        p(class='text-on-surface-variant text-sm') Compartí tus fotos con la comunidad

      //- Flash messages
      if error && error.length
        div(class='mb-6 bg-error-container text-on-error-container text-sm px-4 py-3 rounded-xl')
          each msg in error
            p= msg

      form(action='/publicaciones' method='POST' enctype='multipart/form-data' class='flex flex-col gap-6')

        //- Título
        div(class='flex flex-col gap-2')
          label(class='text-sm font-medium text-on-surface' for='titulo') Título *
          div(class='relative group')
            span(class='material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant group-focus-within:text-primary transition-colors') title
            input(
              class='w-full bg-surface-container border-none focus:ring-2 focus:ring-primary rounded-xl pl-12 py-3.5 text-on-surface placeholder:text-on-surface-variant/50 transition-all'
              id='titulo' name='titulo' type='text' placeholder='Título de tu publicación' required
            )

        //- Descripción
        div(class='flex flex-col gap-2')
          label(class='text-sm font-medium text-on-surface' for='descripcion') Descripción
          textarea(
            class='w-full bg-surface-container border-none focus:ring-2 focus:ring-primary rounded-xl p-4 text-on-surface placeholder:text-on-surface-variant/50 transition-all resize-none'
            id='descripcion' name='descripcion' rows='2' placeholder='Contá algo sobre esta publicación (opcional)'
          )

        //- Imágenes
        div(class='flex flex-col gap-2')
          label(class='text-sm font-medium text-on-surface') Imágenes * (máx. 10)
          div(class='relative group')
            input(
              class='w-full bg-surface-container border-2 border-dashed border-outline rounded-xl p-14 text-on-surface-variant text-sm text-center cursor-pointer hover:border-primary transition-colors file:hidden'
              id='imagenes' name='imagenes' type='file' accept='image/*' multiple required
            )
            label(for='imagenes' class='absolute inset-0 flex flex-col items-center justify-center cursor-pointer gap-2')
              span(class='material-symbols-outlined text-4xl text-on-surface-variant') add_photo_alternate
              span(class='text-on-surface-variant text-sm') Hacé clic para seleccionar imágenes
              span(class='text-on-surface-variant/50 text-xs') JPG, PNG, GIF, WEBP — máx. 5MB por imagen

        //- Licencia
        div(class='flex flex-col gap-2')
          label(class='text-sm font-medium text-on-surface') Licencia *
          div(class='flex gap-4')
            label(class='flex items-center gap-3 bg-surface-container rounded-xl px-4 py-3 cursor-pointer flex-1 border border-transparent hover:border-primary transition-colors')
              input(type='radio' name='licencia' value='libre' checked class='accent-primary')
              div
                p(class='text-on-surface text-sm font-medium') Sin copyright
                p(class='text-on-surface-variant text-xs') Libre uso
            label(class='flex items-center gap-3 bg-surface-container rounded-xl px-4 py-3 cursor-pointer flex-1 border border-transparent hover:border-primary transition-colors')
              input(type='radio' name='licencia' value='copyright' class='accent-primary')
              div
                p(class='text-on-surface text-sm font-medium') Con copyright
                p(class='text-on-surface-variant text-xs') Todos los derechos reservados

        //- Marca de agua (solo si copyright)
        div(id='marca-agua-container' class='flex flex-col gap-2 hidden')
          label(class='text-sm font-medium text-on-surface' for='marca_agua_texto') Texto de marca de agua
          div(class='relative group')
            span(class='material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant group-focus-within:text-primary transition-colors') copyright
            input(
              class='w-full bg-surface-container border-none focus:ring-2 focus:ring-primary rounded-xl pl-12 py-3.5 text-on-surface placeholder:text-on-surface-variant/50 transition-all'
              id='marca_agua_texto' name='marca_agua_texto' type='text' placeholder='Ej: © Tu Nombre 2024'
            )

        //- Etiquetas
        div(class='flex flex-col gap-2')
          label(class='text-sm font-medium text-on-surface' for='etiquetas') Etiquetas
          div(class='relative group')
            span(class='material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant group-focus-within:text-primary transition-colors') tag
            input(
              class='w-full bg-surface-container border-none focus:ring-2 focus:ring-primary rounded-xl pl-12 py-3.5 text-on-surface placeholder:text-on-surface-variant/50 transition-all'
              id='etiquetas' name='etiquetas' type='text' placeholder='naturaleza, viajes, fotografía (separadas por coma)'
            )

        //- Botones
        div(class='flex gap-4 pt-2')
          a(href='/' class='flex-1 flex items-center justify-center py-3 rounded-xl border border-outline text-on-surface-variant text-sm font-medium hover:bg-surface-container transition-colors') Cancelar
          button(
            type='submit'
            class='flex-1 bg-primary text-on-primary font-headline font-bold py-3 rounded-xl hover:bg-primary-container active:scale-[0.98] transition-all text-sm'
          ) Publicar

  script.
    const radios = document.querySelectorAll('input[name="licencia"]')
    const container = document.getElementById('marca-agua-container')
    radios.forEach(r => r.addEventListener('change', () => {
      container.classList.toggle('hidden', r.value !== 'copyright' || !r.checked)
    }))