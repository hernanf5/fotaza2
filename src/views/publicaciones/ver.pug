extends ../layout

block contenido
  div(class='relative flex min-h-screen w-full flex-col overflow-x-hidden')

    //- Navbar
    header(class='flex items-center justify-between whitespace-nowrap border-b border-outline-variant px-6 lg:px-10 py-3 sticky top-0 z-50 bg-background/90 backdrop-blur-md')
      div(class='flex items-center gap-4')
        a(href='/' class='text-primary font-bold text-lg tracking-[-0.015em]') Fotaza 2
      div(class='flex items-center gap-2')
        if usuario
          span(class='text-on-surface-variant text-sm hidden md:block')= usuario.username
          form(action='/logout' method='POST' class='flex items-center')
            button(type='submit' class='flex items-center justify-center rounded-lg h-10 w-10 bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
              span(class='material-symbols-outlined text-xl') logout
        else
          a(href='/login' class='flex items-center justify-center h-10 px-4 rounded-lg bg-surface-container text-primary text-sm font-medium hover:bg-surface-container-high transition-colors') Iniciar sesión

    //- Contenido
    main(class='flex-1 max-w-4xl mx-auto w-full p-6 lg:p-8')

      //- Flash messages
      if error && error.length
        div(class='mb-6 bg-error-container text-on-error-container text-sm px-4 py-3 rounded-xl')
          each msg in error
            p= msg

      if success && success.length
        div(class='mb-6 bg-teal-900 text-teal-100 text-sm px-4 py-3 rounded-xl')
          each msg in success
            p= msg

      //- Cabecera de la publicación
      div(class='mb-6')
        div(class='flex items-center justify-between mb-2')
          h1(class='text-on-surface text-2xl font-bold tracking-tight')= publicacion.titulo
          div(class='flex items-center gap-3')
            if usuario && usuario.id !== publicacion.usuario_id
              a(
                href='/publicaciones/' + publicacion.id + '/denunciar'
                class='flex items-center gap-1 text-on-surface-variant hover:text-error text-xs transition-colors'
              )
                span(class='material-symbols-outlined text-sm') flag
                | Denunciar
            if usuario && usuario.id === publicacion.usuario_id
              div(class='flex gap-2')
                a(
                  href='/publicaciones/' + publicacion.id + '/denuncias-comentarios'
                  class='flex items-center gap-2 px-3 py-2 rounded-lg bg-surface-container text-on-surface-variant text-sm hover:bg-surface-container-high transition-colors'
                )
                  span(class='material-symbols-outlined text-base') flag
                  | Ver denuncias de comentarios
                form(action='/publicaciones/' + publicacion.id + '/comentarios/toggle' method='POST')
                  button(
                    type='submit'
                    class='flex items-center gap-2 px-3 py-2 rounded-lg bg-surface-container text-on-surface-variant text-sm hover:bg-surface-container-high transition-colors'
                  )
                    span(class='material-symbols-outlined text-base')= publicacion.comentarios_abiertos ? 'comments_disabled' : 'comment'
                    | #{publicacion.comentarios_abiertos ? 'Cerrar comentarios' : 'Abrir comentarios'}

        div(class='flex items-center gap-3 text-on-surface-variant text-sm')
          span(class='material-symbols-outlined text-base') person
          a(href='/usuarios/' + publicacion.usuario_id class='hover:text-primary transition-colors')= '@' + publicacion.username
          span(class='text-outline') ·
          span= new Date(publicacion.created_at).toLocaleDateString('es-AR')

        if etiquetas && etiquetas.length
          div(class='flex gap-2 mt-3 flex-wrap')
            each etiqueta in etiquetas
              span(class='text-xs bg-primary/10 text-primary px-3 py-1 rounded-full')= '#' + etiqueta.nombre

      //- Imágenes
      div(class='flex flex-col gap-6 mb-10')
        each imagen in imagenes
          if imagen.licencia === 'libre' || usuario
            div(class='bg-surface rounded-xl overflow-hidden border border-outline-variant')
              img(src=imagen.url alt=publicacion.titulo class='w-full object-cover')
              div(class='p-4 flex items-center justify-between')
                div(class='flex items-center gap-2')
                  span(class='material-symbols-outlined text-primary text-base') star
                  span(class='text-on-surface text-sm font-medium')= imagen.valoracion_promedio.toFixed(1)
                  span(class='text-on-surface-variant text-sm')= '(' + imagen.total_valoraciones + ' valoraciones)'
                div(class='flex items-center gap-2')
                  if imagen.licencia === 'copyright'
                    span(class='flex items-center gap-1 text-xs bg-surface-container text-on-surface-variant px-2 py-1 rounded-full')
                      span(class='material-symbols-outlined text-xs') copyright
                      | Copyright
                  else
                    span(class='flex items-center gap-1 text-xs bg-primary/10 text-primary px-2 py-1 rounded-full')
                      span(class='material-symbols-outlined text-xs') lock_open
                      | Libre uso
                  if usuario && usuario.id !== publicacion.usuario_id
                    div(class='flex items-center gap-3')
                      form(action='/imagenes/' + imagen.id + '/valorar' method='POST' class='flex items-center gap-1')
                        each estrella in [1,2,3,4,5]
                          button(
                            type='submit'
                            name='puntuacion'
                            value=estrella
                            class='text-on-surface-variant hover:text-primary transition-colors'
                          )
                            span(class='material-symbols-outlined text-lg') star
                      form(action='/imagenes/' + imagen.id + '/me-interesa' method='POST')
                        button(
                          type='submit'
                          class='flex items-center gap-1 bg-primary text-on-primary text-xs px-3 py-1.5 rounded-lg hover:bg-primary-container transition-colors font-medium'
                        )
                          span(class='material-symbols-outlined text-sm') favorite
                          | Me interesa
                      a(href='/colecciones/elegir/' + publicacion.id class='flex items-center gap-1 bg-surface-container text-on-surface-variant text-xs px-3 py-1.5 rounded-lg hover:bg-surface-container-high hover:text-primary transition-colors font-medium')
                        span(class='material-symbols-outlined text-sm') bookmark
                        | Guardar
          else
            div(class='bg-surface-container rounded-xl p-8 border border-outline-variant text-center')
              span(class='material-symbols-outlined text-4xl text-on-surface-variant') lock
              p(class='text-on-surface-variant text-sm mt-2') Esta imagen está protegida con copyright.
              a(href='/login' class='text-primary text-sm font-medium mt-2 inline-block') Iniciá sesión para verla

      //- Descripción
      if publicacion.descripcion
        div(class='mb-10 bg-surface-container rounded-xl p-5 border border-outline-variant')
          p(class='text-on-surface-variant text-sm leading-relaxed')= publicacion.descripcion

      //- Comentarios
      div
        h2(class='text-on-surface text-lg font-bold mb-4') Comentarios
        if !publicacion.comentarios_abiertos
          div(class='bg-surface-container rounded-xl p-4 text-on-surface-variant text-sm text-center border border-outline-variant')
            span(class='material-symbols-outlined text-base align-middle mr-1') comments_disabled
            | El autor cerró los comentarios
        else
          if usuario
            form(action='/publicaciones/' + publicacion.id + '/comentarios' method='POST' class='mb-6')
              textarea(
                class='w-full bg-surface-container border-none focus:ring-2 focus:ring-primary rounded-xl p-4 text-on-surface placeholder:text-on-surface-variant/50 transition-all resize-none text-sm'
                name='contenido' rows='2' placeholder='Escribí un comentario...' required
              )
              button(
                type='submit'
                class='mt-2 bg-primary text-on-primary text-sm font-medium px-4 py-2 rounded-lg hover:bg-primary-container transition-colors'
              ) Comentar
          else
            div(class='mb-6 bg-surface-container rounded-xl p-4 text-on-surface-variant text-sm text-center border border-outline-variant')
              | ¿Querés comentar?
              a(href='/login' class='text-primary font-medium ml-1') Iniciá sesión

        //- Lista de comentarios
        div(class='flex flex-col gap-4')
          if comentarios && comentarios.length
            each comentario in comentarios
              div(class='bg-surface-container rounded-xl p-4 border border-outline-variant')
                div(class='flex items-center justify-between mb-2')
                  div(class='flex items-center gap-2')
                    span(class='material-symbols-outlined text-on-surface-variant text-base') person
                    a(href='/usuarios/' + comentario.usuario_id class='text-on-surface text-sm font-medium hover:text-primary transition-colors')= '@' + comentario.username
                    span(class='text-on-surface-variant text-xs')= new Date(comentario.created_at).toLocaleDateString('es-AR')
                  div(class='flex items-center gap-2')
                    if usuario && usuario.id !== comentario.usuario_id
                      a(
                        href='/publicaciones/' + publicacion.id + '/comentarios/' + comentario.id + '/denunciar'
                        class='text-on-surface-variant hover:text-error transition-colors'
                        title='Denunciar comentario'
                      )
                        span(class='material-symbols-outlined text-base') flag
                    if usuario && usuario.id === publicacion.usuario_id
                      form(action='/publicaciones/' + publicacion.id + '/comentarios/' + comentario.id + '/eliminar' method='POST')
                        button(type='submit' class='text-on-surface-variant hover:text-error transition-colors')
                          span(class='material-symbols-outlined text-base') delete
                p(class='text-on-surface text-sm leading-relaxed')= comentario.contenido
          else
            p(class='text-on-surface-variant text-sm text-center py-4') No hay comentarios todavía.