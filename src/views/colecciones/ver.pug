extends ../layout

block contenido
  div(class='relative flex min-h-screen w-full flex-col overflow-x-hidden')

    //- Navbar
    header(class='flex items-center justify-between whitespace-nowrap border-b border-outline-variant px-6 lg:px-10 py-3 sticky top-0 z-50 bg-background/90 backdrop-blur-md')
      div(class='flex items-center gap-4')
        a(href='/' class='text-primary font-bold text-lg tracking-[-0.015em]') Fotaza 2
        a(href='/colecciones' class='text-on-surface-variant hover:text-primary text-sm transition-colors') Mis colecciones
      div(class='flex items-center gap-2')
        if usuario
          span(class='text-on-surface-variant text-sm hidden md:block')= usuario.username
          form(action='/logout' method='POST' class='flex items-center')
            button(type='submit' class='flex items-center justify-center rounded-lg h-10 w-10 bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
              span(class='material-symbols-outlined text-xl') logout

    main(class='flex-1 max-w-4xl mx-auto w-full p-6 lg:p-8')

      //- Flash messages
      if error && error.length
        div(class='mb-6 bg-error-container text-on-error-container text-sm px-4 py-3 rounded-xl')
          each msg in error
            p= msg
      if success && success.length
        div(class='mb-6 bg-teal-900 text-teal-100 text-sm px-4 py-3 rounded-xl')
          each msg in success
            p= msg

      //- Cabecera
      div(class='flex items-center justify-between mb-8')
        h1(class='text-on-surface text-2xl font-bold tracking-tight')= coleccion.nombre
        p(class='text-on-surface-variant text-sm')= publicaciones.length + ' publicaciones'

      //- Publicaciones
      if publicaciones && publicaciones.length
        div(class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6')
          each pub in publicaciones
            div(class='group flex flex-col bg-surface rounded-xl overflow-hidden border border-outline-variant hover:border-primary hover:bg-surface-container transition-all')
              a(href='/publicaciones/' + pub.id)
                if pub.imagen_portada
                  div(class='relative aspect-video w-full overflow-hidden')
                    img(src=pub.imagen_portada alt=pub.titulo class='w-full h-full object-cover transition-transform duration-500 group-hover:scale-105')
              div(class='p-4')
                h3(class='text-on-surface font-medium text-base mb-1 truncate')= pub.titulo
                p(class='text-on-surface-variant text-xs mb-3')= '@' + pub.username
                form(action='/colecciones/' + coleccion.id + '/quitar' method='POST')
                  input(type='hidden' name='publicacion_id' value=pub.id)
                  button(
                    type='submit'
                    class='w-full flex items-center justify-center gap-2 border border-outline text-on-surface-variant text-xs py-2 rounded-lg hover:border-error hover:text-error transition-colors'
                  )
                    span(class='material-symbols-outlined text-sm') bookmark_remove
                    | Quitar de colección
      else
        div(class='bg-surface-container rounded-xl p-12 text-center border border-outline-variant')
          span(class='material-symbols-outlined text-4xl text-on-surface-variant') photo_library
          p(class='text-on-surface-variant text-sm mt-2') Esta colección está vacía.