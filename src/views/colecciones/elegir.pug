extends ../layout

block contenido
  div(class='relative flex min-h-screen w-full flex-col overflow-x-hidden')

    //- Navbar
    header(class='flex items-center justify-between whitespace-nowrap border-b border-outline-variant px-6 lg:px-10 py-3 sticky top-0 z-50 bg-background/90 backdrop-blur-md')
      div(class='flex items-center gap-4')
        a(href='/' class='text-primary font-bold text-lg tracking-[-0.015em]') Fotaza 2
      div(class='flex items-center gap-2')
        if usuario
          span(class='text-on-surface-variant text-sm hidden md:block')= usuario.username
          form(action='/logout' method='POST' class='flex items-center')
            button(type='submit' class='flex items-center justify-center rounded-lg h-10 w-10 bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
              span(class='material-symbols-outlined text-xl') logout

    main(class='flex-1 max-w-lg mx-auto w-full p-6 lg:p-8')

      div(class='mb-8')
        h1(class='text-on-surface text-2xl font-bold tracking-tight mb-1') Guardar en colección
        p(class='text-on-surface-variant text-sm') Elegí en qué colección querés guardar esta publicación

      //- Flash messages
      if error && error.length
        div(class='mb-6 bg-error-container text-on-error-container text-sm px-4 py-3 rounded-xl')
          each msg in error
            p= msg

      //- Colecciones existentes
      if colecciones && colecciones.length
        div(class='flex flex-col gap-3 mb-8')
          each col in colecciones
            form(action='/colecciones/' + col.id + '/agregar' method='POST')
              input(type='hidden' name='publicacion_id' value=publicacion_id)
              button(
                type='submit'
                class='w-full flex items-center justify-between gap-3 p-4 bg-surface rounded-xl border border-outline-variant hover:border-primary hover:bg-surface-container transition-all text-left'
              )
                div(class='flex items-center gap-3')
                  span(class='material-symbols-outlined text-primary') folder
                  div
                    p(class='text-on-surface text-sm font-medium')= col.nombre
                    p(class='text-on-surface-variant text-xs')= col.total_publicaciones + ' publicaciones'
                span(class='material-symbols-outlined text-on-surface-variant') chevron_right
      else
        div(class='bg-surface-container rounded-xl p-6 text-center border border-outline-variant mb-8')
          span(class='material-symbols-outlined text-3xl text-on-surface-variant') folder_open
          p(class='text-on-surface-variant text-sm mt-2') No tenés colecciones todavía.

      //- Crear nueva colección y guardar directo
      div(class='border-t border-outline-variant pt-6')
        p(class='text-on-surface-variant text-sm mb-3') O creá una nueva colección
        form(action='/colecciones/nueva-y-guardar' method='POST' class='flex gap-3')
          input(type='hidden' name='publicacion_id' value=publicacion_id)
          div(class='relative group flex-1')
            span(class='material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant group-focus-within:text-primary transition-colors') folder
            input(
              class='w-full bg-surface-container border-none focus:ring-2 focus:ring-primary rounded-xl pl-12 py-3 text-on-surface placeholder:text-on-surface-variant/50 transition-all text-sm'
              name='nombre' type='text' placeholder='Nombre de la colección' required
            )
          button(
            type='submit'
            class='bg-primary text-on-primary text-sm font-medium px-4 py-3 rounded-xl hover:bg-primary-container transition-colors'
          ) Crear y guardar

      //- Cancelar
      div(class='mt-4 text-center')
        a(href='/publicaciones/' + publicacion_id class='text-on-surface-variant text-sm hover:text-primary transition-colors') Cancelar