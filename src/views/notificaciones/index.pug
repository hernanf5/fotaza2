extends ../layout

block contenido
  div(class='relative flex min-h-screen w-full flex-col overflow-x-hidden')

    //- Navbar
    header(class='flex items-center justify-between whitespace-nowrap border-b border-outline-variant px-6 lg:px-10 py-3 sticky top-0 z-50 bg-background/90 backdrop-blur-md')
      div(class='flex items-center gap-4')
        a(href='/' class='text-primary font-bold text-lg tracking-[-0.015em]') Fotaza 2
      div(class='flex items-center gap-2')
        if usuario
          span(class='text-on-surface-variant text-sm hidden md:block')= usuario.username
          form(action='/logout' method='POST' class='flex items-center')
            button(type='submit' class='flex items-center justify-center rounded-lg h-10 w-10 bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
              span(class='material-symbols-outlined text-xl') logout

    main(class='flex-1 max-w-3xl mx-auto w-full p-6 lg:p-8')

      //- Cabecera
      div(class='flex items-center justify-between mb-8')
        h1(class='text-on-surface text-2xl font-bold tracking-tight') Notificaciones
        form(action='/notificaciones/leer-todas' method='POST')
          button(
            type='submit'
            class='text-sm text-on-surface-variant hover:text-primary transition-colors'
          ) Marcar todas como leídas

      //- Flash messages
      if error && error.length
        div(class='mb-6 bg-error-container text-on-error-container text-sm px-4 py-3 rounded-xl')
          each msg in error
            p= msg

      //- Lista de notificaciones
      if notificaciones && notificaciones.length
        div(class='flex flex-col gap-3')
          each notif in notificaciones
            div(class='flex items-start justify-between gap-4 p-4 rounded-xl border transition-colors ' + (notif.leida ? 'bg-surface border-outline-variant' : 'bg-surface-container border-primary/30'))

              div(class='flex items-start gap-3')
                //- Ícono según tipo
                div(class='w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 ' + (notif.leida ? 'bg-surface-container' : 'bg-primary/10'))
                  if notif.tipo === 'comentario'
                    span(class='material-symbols-outlined ' + (notif.leida ? 'text-on-surface-variant' : 'text-primary')) comment
                  else if notif.tipo === 'valoracion'
                    span(class='material-symbols-outlined ' + (notif.leida ? 'text-on-surface-variant' : 'text-primary')) star
                  else if notif.tipo === 'nuevo_seguidor'
                    span(class='material-symbols-outlined ' + (notif.leida ? 'text-on-surface-variant' : 'text-primary')) person_add
                  else if notif.tipo === 'me_interesa'
                    span(class='material-symbols-outlined ' + (notif.leida ? 'text-on-surface-variant' : 'text-primary')) favorite

                div
                  p(class='text-on-surface text-sm')
                    span(class='font-medium')= '@' + notif.origen_username
                    if notif.tipo === 'comentario'
                      |  comentó tu publicación
                    else if notif.tipo === 'valoracion'
                      |  valoró una de tus imágenes
                    else if notif.tipo === 'nuevo_seguidor'
                      |  comenzó a seguirte
                    else if notif.tipo === 'me_interesa'
                      |  marcó "me interesa" en una de tus imágenes
                  p(class='text-on-surface-variant text-xs mt-1')= new Date(notif.created_at).toLocaleDateString('es-AR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })

              //- Marcar como leída
              if !notif.leida
                form(action='/notificaciones/' + notif.id + '/leer' method='POST')
                  button(
                    type='submit'
                    class='text-on-surface-variant hover:text-primary transition-colors flex-shrink-0'
                    title='Marcar como leída'
                  )
                    span(class='material-symbols-outlined text-base') done

      else
        div(class='bg-surface-container rounded-xl p-12 text-center border border-outline-variant')
          span(class='material-symbols-outlined text-4xl text-on-surface-variant') notifications_none
          p(class='text-on-surface-variant text-sm mt-2') No tenés notificaciones todavía.