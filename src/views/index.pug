extends layout

block contenido
  div(class='relative flex min-h-screen w-full flex-col overflow-x-hidden')

    //- Navbar
    header(class='flex items-center justify-between whitespace-nowrap border-b border-outline-variant px-6 lg:px-10 py-3 sticky top-0 z-50 bg-background/90 backdrop-blur-md')
      div(class='flex items-center gap-8')
        div(class='flex items-center gap-4 text-primary')
          h2(class='text-primary text-lg font-bold leading-tight tracking-[-0.015em]') Fotaza 2
        label(class='hidden md:flex flex-col min-w-40 h-10 max-w-64')
          div(class='flex w-full flex-1 items-stretch rounded-lg h-full')
            div(class='text-on-surface-variant flex border-none bg-surface-container items-center justify-center pl-4 rounded-l-lg')
              span(class='material-symbols-outlined text-xl') search
            input(
              class='flex w-full min-w-0 flex-1 bg-surface-container text-on-surface focus:outline-0 focus:ring-0 border-none h-full placeholder:text-on-surface-variant px-4 rounded-r-lg text-sm'
              placeholder='Buscar...'
            )

      div(class='flex flex-1 justify-end gap-8')
        div(class='flex gap-2')
          a(href='/notificaciones' class='flex items-center justify-center rounded-lg h-10 w-10 bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
            span(class='material-symbols-outlined text-xl') notifications
          if usuario
            a(href='#' class='flex items-center justify-center rounded-lg h-10 w-10 bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
              span(class='material-symbols-outlined text-xl') person
            form(action='/logout' method='POST' class='flex items-center')
              button(type='submit' class='flex items-center justify-center rounded-lg h-10 w-10 bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
                span(class='material-symbols-outlined text-xl') logout
          else
            a(href='/login' class='text-sm font-medium text-primary') Iniciar sesión

    div(class='flex flex-1')

      //- Sidebar
      aside(class='hidden lg:flex w-64 flex-col border-r border-outline-variant h-[calc(100vh-57px)] sticky top-[57px] bg-background p-4 shrink-0 overflow-y-auto')
        div(class='flex flex-col gap-6')
          div(class='flex flex-col')
            h3(class='text-on-surface text-base font-medium mb-1') Navegación
            p(class='text-on-surface-variant text-sm') Explorá la comunidad
          div(class='flex flex-col gap-1')
            a(href='/' class='flex items-center gap-3 px-3 py-2.5 rounded-lg bg-primary/10 text-primary')
              span(class='material-symbols-outlined text-2xl') home
              span(class='text-sm font-medium') Inicio
            a(href='#' class='flex items-center gap-3 px-3 py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors')
              span(class='material-symbols-outlined text-2xl') group
              span(class='text-sm font-medium') Usuarios que sigo
            a(href='#' class='flex items-center gap-3 px-3 py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors')
              span(class='material-symbols-outlined text-2xl') bookmark
              span(class='text-sm font-medium') Colecciones
            if usuario
              a(href='/publicaciones/nueva' class='flex items-center gap-3 px-3 py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors')
                span(class='material-symbols-outlined text-2xl') add_photo_alternate
                span(class='text-sm font-medium') Nueva publicación

      //- Contenido principal
      main(class='flex-1 flex flex-col max-w-7xl mx-auto w-full')
        div(class='p-6 lg:p-8')

          //- Buscador
          div(class='mb-8')
            label(class='flex flex-col w-full h-14')
              div(class='flex w-full flex-1 items-stretch rounded-xl h-full border border-outline-variant focus-within:border-primary transition-colors')
                div(class='text-on-surface-variant flex bg-surface items-center justify-center pl-5 rounded-l-xl')
                  span(class='material-symbols-outlined text-2xl') search
                input(
                  class='flex w-full min-w-0 flex-1 bg-surface text-on-surface focus:outline-0 border-none px-4 rounded-r-xl text-base placeholder:text-on-surface-variant'
                  placeholder='Buscá imágenes y publicaciones...'
                )
            div(class='flex gap-3 mt-4 flex-wrap')
              button(class='flex h-9 items-center justify-center gap-2 rounded-lg bg-surface-container border border-outline-variant px-4 hover:bg-surface-container-high transition-colors')
                span(class='text-on-surface-variant text-sm font-medium') Categoría
                span(class='material-symbols-outlined text-lg text-on-surface-variant') arrow_drop_down
              button(class='flex h-9 items-center justify-center gap-2 rounded-lg bg-surface-container border border-outline-variant px-4 hover:bg-surface-container-high transition-colors')
                span(class='text-on-surface-variant text-sm font-medium') Licencia
                span(class='material-symbols-outlined text-lg text-on-surface-variant') arrow_drop_down
              button(class='flex h-9 items-center justify-center gap-2 rounded-lg bg-surface-container border border-outline-variant px-4 hover:bg-surface-container-high transition-colors')
                span(class='text-on-surface-variant text-sm font-medium') Valoración
                span(class='material-symbols-outlined text-lg text-on-surface-variant') arrow_drop_down

          //- Sección tendencias
          div(class='mb-12')
            div(class='flex items-center justify-between mb-6')
              h2(class='text-on-surface text-2xl font-bold leading-tight tracking-tight') Tendencias
              a(href='#' class='text-primary hover:text-primary-container text-sm font-medium') Ver todas

            div(class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6')

              //- Card 1
