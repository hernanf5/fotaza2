extends layout

block contenido
  div(class='relative flex min-h-screen w-full flex-col overflow-x-hidden')

    //- Navbar
    header(class='flex items-center justify-between whitespace-nowrap border-b border-outline-variant px-6 lg:px-10 py-3 sticky top-0 z-50 bg-background/90 backdrop-blur-md')
      div(class='flex items-center gap-4')
        a(href='/' class='text-primary font-bold text-lg tracking-[-0.015em]') Fotaza 2
      div(class='flex items-center gap-2')
        if usuario
          span(class='text-on-surface-variant text-sm hidden md:block center')= usuario.username
          a(href='/notificaciones' class='relative flex items-center justify-center rounded-lg h-10 w-10 bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
            span(class='material-symbols-outlined text-xl') notifications
            if notificaciones_no_leidas > 0
              span(class='absolute -top-1 -right-1 bg-primary text-on-primary text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center')= notificaciones_no_leidas
          a(href='/mensajes' class='relative flex items-center justify-center rounded-lg h-10 w-10 bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
            span(class='material-symbols-outlined text-xl') chat_bubble_outline
            if mensajes_no_leidos > 0
              span(class='absolute -top-1 -right-1 bg-primary text-on-primary text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center')= mensajes_no_leidos
          form(action='/logout' method='POST' class='flex items-center')
            button(type='submit' class='flex items-center justify-center rounded-lg h-10 w-10 bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors')
              span(class='material-symbols-outlined text-xl') logout
        else
          a(href='/login' class='text-sm font-medium text-primary') Iniciar sesión

    div(class='flex flex-1')

      //- Sidebar
      aside(class='hidden lg:flex w-64 flex-col border-r border-outline-variant h-[calc(100vh-57px)] sticky top-[57px] bg-background p-4 shrink-0 overflow-y-auto')
        div(class='flex flex-col gap-6')
          div(class='flex flex-col')
            h3(class='text-on-surface text-base font-medium mb-1') Navegación
            p(class='text-on-surface-variant text-sm') Explorá la comunidad
          div(class='flex flex-col gap-1')
            a(href='/' class='flex items-center gap-3 px-3 py-2.5 rounded-lg bg-primary/10 text-primary')
              span(class='material-symbols-outlined text-2xl') home
              span(class='text-sm font-medium') Inicio
            a(href='/buscar' class='flex items-center gap-3 px-3 py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors')
              span(class='material-symbols-outlined text-2xl') search
              span(class='text-sm font-medium') Buscar
            a(href='/siguiendo' class='flex items-center gap-3 px-3 py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors')
              span(class='material-symbols-outlined text-2xl') group
              span(class='text-sm font-medium') Usuarios que sigo
            a(href='/colecciones' class='flex items-center gap-3 px-3 py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors')
              span(class='material-symbols-outlined text-2xl') bookmark
              span(class='text-sm font-medium') Colecciones
            if usuario
              a(href='/usuarios/' + usuario.id class='flex items-center gap-3 px-3 py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors')
                span(class='material-symbols-outlined text-2xl') person
                span(class='text-sm font-medium') Mi perfil
              a(href='/publicaciones/nueva' class='flex items-center gap-3 px-3 py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors')
                span(class='material-symbols-outlined text-2xl') add_photo_alternate
                span(class='text-sm font-medium') Nueva publicación

      //- Contenido principal
      main(class='flex-1 flex flex-col max-w-7xl mx-auto w-full')
        div(class='p-6 lg:p-8')

          //- Sección tendencias
          div(class='mb-12')
            div(class='flex items-center justify-between mb-6')
              h2(class='text-on-surface text-2xl font-bold leading-tight tracking-tight') Destacadas
              a(href='/buscar' class='text-primary hover:text-primary-container text-sm font-medium') Ver todas

            if destacadas && destacadas.length
              div(class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6')
                each pub in destacadas
                  a(href='/publicaciones/' + pub.id class='group flex flex-col bg-surface rounded-xl overflow-hidden border border-outline-variant hover:border-primary hover:bg-surface-container transition-all')
                    div(class='relative aspect-video w-full overflow-hidden')
                      if pub.imagen_portada
                        img(src=pub.imagen_portada alt=pub.titulo class='w-full h-full object-cover transition-transform duration-500 group-hover:scale-105')
                      else
                        div(class='w-full h-full bg-surface-container-high flex items-center justify-center')
                          span(class='material-symbols-outlined text-4xl text-on-surface-variant') image
                      div(class='absolute top-3 right-3 bg-black/60 backdrop-blur-sm rounded-lg px-2 py-1 flex items-center gap-1')
                        span(class='material-symbols-outlined text-primary text-sm') star
                        span(class='text-white text-xs font-medium')= parseFloat(pub.valoracion_promedio).toFixed(1)
                    div(class='p-4')
                      h3(class='text-on-surface font-medium text-base mb-1 truncate')= pub.titulo
                      p(class='text-on-surface-variant text-sm mb-4')= pub.total_valoraciones + ' votos'
                      if usuario
                        button(class='w-full flex items-center justify-center gap-2 bg-primary text-on-primary py-2 rounded-lg font-medium text-sm hover:bg-primary-container transition-colors')
                          span(class='material-symbols-outlined text-lg') bookmark
                          | Guardar
            else
              div(class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6')
                each pub in recientes
                  a(href='/publicaciones/' + pub.id class='group flex flex-col bg-surface rounded-xl overflow-hidden border border-outline-variant hover:border-primary hover:bg-surface-container transition-all')
                    div(class='relative aspect-video w-full overflow-hidden')
                      if pub.imagen_portada
                        img(src=pub.imagen_portada alt=pub.titulo class='w-full h-full object-cover transition-transform duration-500 group-hover:scale-105')
                      else
                        div(class='w-full h-full bg-surface-container-high flex items-center justify-center')
                          span(class='material-symbols-outlined text-4xl text-on-surface-variant') image
                    div(class='p-4')
                      h3(class='text-on-surface font-medium text-base mb-1 truncate')= pub.titulo
                      p(class='text-on-surface-variant text-sm mb-4')= '@' + pub.username
                      if usuario
                        button(class='w-full flex items-center justify-center gap-2 bg-primary text-on-primary py-2 rounded-lg font-medium text-sm hover:bg-primary-container transition-colors')
                          span(class='material-symbols-outlined text-lg') bookmark
                          | Guardar